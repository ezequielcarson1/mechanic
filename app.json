{
  "expo": {
    "name": "Mechanic Assitance V2",
    "slug": "mechanic-assistance-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mechanic-icon.png",
    "scheme": "mechanic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixel.mechanic",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.pixel.mechanic"
            ]
          }
        ]
      }
    },
    "android": {
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/mechanic-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pixel.mechanic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mechanic-icon.png",
      "bundler": "metro",
      "display": "standalone",
      "backgroundColor": "#ffffff",
      "themeColor": "#0047AB",
      "description": "Professional Mechanic Assistance App",
      "orientation": "portrait",
      "startUrl": "/",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "black-translucent"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withFirebasePodfile",
      "./plugins/withFirebaseAuthAPNS",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e19e74e-d50d-4110-bbbb-2edd9eb3f4ee"
      }
    }
  }
}